{
  "name": "yt-auto-downloader",
  "version": "1.0.0",
  "devDependencies": {
    "@eslint/js": "latest",
    "@heroui/theme": "^2.4.26",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "latest",
    "eslint-plugin-jsdoc": "^62.8.0",
    "postcss": "^8.5.8",
    "typescript": "^5.3.0",
    "typescript-eslint": "latest"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter @yt-auto-downloader/backend dev",
    "dev:frontend": "BACKEND_PORT=$(grep '^PORT=' .env | cut -d= -f2 || echo 3000) bun run --filter @yt-auto-downloader/frontend dev",
    "dev:all": "bun run dev & bun run dev:frontend",
    "build:frontend": "bun run --filter @yt-auto-downloader/frontend build",
    "start": "bun run --filter @yt-auto-downloader/backend start",
    "lint": "eslint apps --ext .ts,.tsx --ignore-pattern '**/dist/**' --ignore-pattern '**/node_modules/**'",
    "build:check": "bun run --filter @yt-auto-downloader/backend build:check",
    "test": "bun test"
  },
  "type": "module",
  "workspaces": [
    ".",
    "apps/*",
    "packages/*"
  ]
}
