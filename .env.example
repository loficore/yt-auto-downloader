# ===========================================
# YouTube Auto Downloader 配置
# ===========================================

# ============ 服务器配置 ============
# 后端服务端口
PORT=3000

# ============ 文件配置 ============
# 下载文件保存目录（相对于项目根目录）
DOWNLOAD_DIR=./data/Downloads/

# SQLite 数据库文件路径
DB_PATH=./data/downloads.db

# ============ 网络代理（可选）============
# HTTP/HTTPS/SOCKS 代理，用于下载 YouTube 视频
# 示例: socks5://127.0.0.1:7890 或 http://127.0.0.1:7890
# PROXY=

# yt-dlp 专用代理（如果与 PROXY 不同）
# YTDLP_PROXY=

# ============ 认证方式（二选一）============
# 方式1: 使用浏览器 Cookie（需要浏览器正在运行）
# 可选值: chrome, chromium, brave, edge, firefox
# YTDLP_COOKIES_FROM_BROWSER=

# 方式2: 使用 Cookie 文件（推荐，更稳定）
# 从浏览器导出 Netscape 格式的 cookie 文件
# 可使用浏览器插件: "Get cookies.txt LOCALLY" 或 "EditThisCookie"
# 示例: ./config/music.youtube.com_cookies.txt
# YTDLP_COOKIES_FILE=

# ============ 日志配置 ============
# 日志文件目录（相对于项目根目录）
LOG_DIR=./logs

# 日志文件名（不含日期和扩展名）
LOG_FILENAME=yt-downloader

# 日志级别: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============ 同步配置 ============
# 每次同步最多下载的视频数量
MAX_DOWNLOADS_PER_SYNC=10

# ============ 调度器配置 ============
# 启用定时调度器
SCHEDULER_ENABLED=true

# Cron 表达式（每天凌晨 6 点执行）
SCHEDULER_CRON=0 6 * * *

# 时区
TIMEZONE=UTC

# ============ 下载限流配置 ============
# 每分钟最大下载数 (RPM)，防止被 YouTube 风控
MAX_DOWNLOADS_PER_MINUTE=5

# 随机延迟范围 (毫秒)，模拟人类行为
# 最小延迟
DOWNLOAD_DELAY_MIN=1000
# 最大延迟
DOWNLOAD_DELAY_MAX=5000

# ============ 自动清理配置 ============
# 自动清理已完成任务的天数（0 表示不自动清理）
AUTO_CLEAR_DAYS=30
